# Required
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Discord webhook for family alerts
# Get one at: Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# AI Provider selection: auto | gemini | ollama
# auto = try Gemini first, fall back to Ollama if it fails
LLM_PROVIDER=auto

# Gemini model — official Gemma 4 multimodal model on Gemini API
GEMINI_MODEL=gemma-4-26b-a4b-it

# Ollama model (local fallback)
OLLAMA_MODEL=gemma4:e4b
OLLAMA_BASE_URL=http://localhost:11434
